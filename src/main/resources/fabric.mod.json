{
	"schemaVersion": 1,
	"id": "justaclient",
	"version": "${version}",
	"name": "Justaclient",
	"description": "A visuals-only Fabric client: smooth animated UI, blur, sharp fonts and a fully themeable look. No cheats.",
	"authors": [
		"tm-coder-484"
	],
	"contact": {
		"sources": "https://github.com/tm-coder-484/justaclient",
		"issues": "https://github.com/tm-coder-484/justaclient/issues"
	},
	"license": "MIT",
	"icon": "assets/justaclient/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.justaclient.Justaclient"
		]
	},
	"mixins": [
		"justaclient.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.17.0",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*",
		"sodium": ">=0.8.0"
	}
}
